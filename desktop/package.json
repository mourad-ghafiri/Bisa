  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-excalidraw-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-excalidraw-assets.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test --import ./src/i18n/preload.mjs \"src/**/*.test.mjs\"",
    "test:coverage": "node --test --import ./src/i18n/preload.mjs --experimental-test-coverage --test-coverage-include=\"src/**/*.mjs\" --test-coverage-exclude=\"src/**/*.test.mjs\" --test-coverage-lines=80 \"src/**/*.test.mjs\"",
    "test:coverage:lcov": "node --test --import ./src/i18n/preload.mjs --experimental-test-coverage --test-coverage-include=\"src/**/*.mjs\" --test-coverage-exclude=\"src/**/*.test.mjs\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=../target/coverage/desktop.lcov \"src/**/*.test.mjs\"",
    "lint": "eslint ."
  },
