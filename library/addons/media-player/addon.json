{
  "id": "media-player",
  "name": "Media player",
  "description": "Plays audio and video from a file, a link or YouTube — a live spectrogram for sound, YouTube's own player for its videos, and the last twenty sources one pick away.",
  "version": "0.6.0",
  "author": "Bisa",
  "homepage": "https://bisa.dev",
  "repo": "https://github.com/mourad-ghafiri/Bisa",
  "license": "MIT",
  "tags": [
    "media",
    "tool"
  ],
  "window": {
    "width": 440,
    "height": 320,
    "min_width": 300,
    "min_height": 260,
    "max_width": 1200,
    "max_height": 800,
    "resizable": true,
    "default_dock": "bottom_right"
  },
  "permissions": [
    "storage",
    "open_url",
    {
      "media": {
        "hosts": [
          "*"
        ],
        "youtube": true
      }
    }
  ]
}
