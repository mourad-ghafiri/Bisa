cli-security-no-note = no note
cli-security-reach-judged = judged before it runs
cli-security-reach-judged-restores = judged before it runs · restores placeholders
cli-security-reach-observed-only = observed only — runs under its own sandbox
cli-security-verdict-allowed = allowed
cli-security-verdict-asked = asked
cli-security-verdict-no-rule = no rule
cli-security-verdict-refused = refused
cli-session-resolves-nothing = { $host }:{ $port } resolves to nothing
cli-workflow-not-workflow-definition = { $src }: not a workflow definition
cli-arg-connector-account-add-params =
    .help = A non-secret parameter the connector declares, `k=v`
cli-arg-connector-account-add-secrets =
    .help = A secret field, `field=@stdin`, `field=@path` or `field=VALUE`
cli-arg-connector-account-add-default =
    .help = Make it the connector's default account
cli-cmd-mcp-list =
    .about = List registered servers
cli-arg-mcp-list-tags =
    .help = Show only what carries this tag (repeatable). See `bisa tags`
cli-arg-mcp-list-match_mode =
    .help = How several --tag values combine: any (default) or all
cli-cmd-mcp-show =
    .about = Show one server, including its transport
cli-cmd-mcp-add =
    .about = Register a server
cli-arg-mcp-add-id =
    .help = Stable id agents reference: lowercase letters, digits, `-` and `_`
cli-arg-mcp-add-name =
    .help = The name the harness sees. It may not be `bisa`: the engine injects its own server under that name into every session
cli-arg-mcp-add-command =
    .help = stdio transport: the command that starts the server
cli-arg-mcp-add-args =
    .help = Argument for --command, in order (repeatable). Hyphens are values here, not flags: `--arg -y` is how nearly every stdio server is launched
cli-arg-mcp-add-env =
    .help = Environment entry for --command, `KEY=VALUE` (repeatable). It is stored on this machine only, never published with the agent, and never printed back
cli-arg-mcp-add-cwd =
    .help = Working directory for --command; absent, the session's own
cli-arg-mcp-add-url =
    .help = Remote transport: the server's URL (Streamable HTTP)
cli-arg-mcp-add-sse =
    .help = The URL speaks the 2024-11-05 HTTP+SSE transport, not Streamable HTTP
cli-arg-mcp-add-headers =
    .help = Header sent with every request to --url, `Name: value` or `Name=value` (repeatable) — a bearer token, an API key; never printed back
cli-arg-mcp-add-tags =
    .help = Category tag (repeatable). Passing any --tag replaces the whole list, so name every tag you want kept. See `bisa tags`
cli-cmd-mcp-edit =
    .about = Change a server. The id is fixed: agents reference it
cli-arg-mcp-edit-command =
    .help = stdio transport: the command that starts the server
cli-arg-mcp-edit-args =
    .help = Argument for --command, in order (repeatable). Hyphens are values here, not flags: `--arg -y` is how nearly every stdio server is launched
cli-arg-mcp-edit-env =
    .help = Environment entry for --command, `KEY=VALUE` (repeatable). It is stored on this machine only, never published with the agent, and never printed back
cli-arg-mcp-edit-cwd =
    .help = Working directory for --command; absent, the session's own
cli-arg-mcp-edit-url =
    .help = Remote transport: the server's URL (Streamable HTTP)
cli-arg-mcp-edit-sse =
    .help = The URL speaks the 2024-11-05 HTTP+SSE transport, not Streamable HTTP
cli-arg-mcp-edit-headers =
    .help = Header sent with every request to --url, `Name: value` or `Name=value` (repeatable) — a bearer token, an API key; never printed back
cli-arg-mcp-edit-tags =
    .help = Category tag (repeatable). Passing any --tag replaces the whole list, so name every tag you want kept. See `bisa tags`
cli-cmd-mcp-usage =
    .about = Which agents carry this server
cli-cmd-mcp-probe =
    .about = Dial a server and print what answered: who, the negotiated protocol revision and era, its capabilities and tools — or the stage it stopped at. A registered server by id, or a transport given here
cli-arg-mcp-probe-id =
    .help = A registered server; leave it out to probe --command or --url
cli-arg-mcp-probe-command =
    .help = stdio transport: the command that starts the server
cli-arg-mcp-probe-args =
    .help = Argument for --command, in order (repeatable). Hyphens are values here, not flags: `--arg -y` is how nearly every stdio server is launched
cli-arg-mcp-probe-env =
    .help = Environment entry for --command, `KEY=VALUE` (repeatable). It is stored on this machine only, never published with the agent, and never printed back
cli-arg-mcp-probe-cwd =
    .help = Working directory for --command; absent, the session's own
cli-arg-mcp-probe-url =
    .help = Remote transport: the server's URL (Streamable HTTP)
cli-arg-mcp-probe-sse =
    .help = The URL speaks the 2024-11-05 HTTP+SSE transport, not Streamable HTTP
cli-arg-mcp-probe-headers =
    .help = Header sent with every request to --url, `Name: value` or `Name=value` (repeatable) — a bearer token, an API key; never printed back
cli-arg-mcp-probe-timeout_secs =
    .help = How long to wait for the whole conversation, 1–30 seconds
cli-cmd-mcp-rm =
    .about = Delete a server. Refused while any agent still carries it — detach it there first (`bisa mcp usage <id>` lists them)
cli-cmd-mcp-enable =
    .about = Switch a server on
cli-cmd-mcp-disable =
    .about = Switch a server off. Agents keep the reference; sessions skip it
