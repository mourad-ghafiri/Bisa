cli-cmd-project-unstage =
    .about = Take files back out of the index. **The files themselves are left exactly as they are.**
cli-cmd-pulse =
    .about = The workspace activity feed
cli-cmd-read =
    .about = Mark a conversation read
cli-cmd-recall =
    .about = An agent's memory (owner view)
cli-cmd-recall-get =
    .about = Read one memory by slug
cli-cmd-recall-list =
    .about = List an agent's memories (owner view)
cli-cmd-relay =
