cli-cmd-project-adopt =
    .about = Adopt an existing folder anywhere on disk, by reference. Bisa writes nothing into it — workstreams live beside it, under the project's own record
cli-cmd-project-assign =
    .about = Set who carries a project: its agents take work that runs here, its humans may decide its gates
cli-cmd-project-attach =
