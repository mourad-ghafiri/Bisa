cli-cmd-relay-list =
    .about = The configured relays — with their health when a node runs
cli-cmd-relay-peer-add =
    .about = Add a direct peer by hand (member pubkey + endpoint id + socket addr) under `sync.iroh.peers`
cli-cmd-relay-remove =
    .about = Remove a relay URL from `sync.relays`
