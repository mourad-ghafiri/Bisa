cli-cmd-project-clone =
    .about = Clone a repository into a new project folder
cli-cmd-project-commit =
    .about = Commit the project's folder. Named paths are staged first; with none, what is already staged is committed — never "everything"
cli-cmd-project-detach =
    .about = Detach a project from a goal (moves no bytes)
cli-cmd-project-diff =
    .about = One file's patch
cli-cmd-project-files =
